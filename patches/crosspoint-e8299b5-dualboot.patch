+namespace {
+const char* seeedashErrorMessage(HalSystem::SeeedashBootStatus status) {
+  using Status = HalSystem::SeeedashBootStatus;
+  switch (status) {
+    case Status::Ready:
+      return "";
+    case Status::ReturnNotVerified:
+      return tr(STR_SEEEDASH_RETURN_UNVERIFIED);
+    case Status::LayoutMismatch:
+      return tr(STR_SEEEDASH_LAYOUT_ERROR);
+    case Status::ImageMismatch:
+      return tr(STR_SEEEDASH_IMAGE_ERROR);
+    case Status::BootloaderMismatch:
+      return tr(STR_SEEEDASH_BOOTLOADER_ERROR);
+    case Status::JournalInvalid:
+      return tr(STR_SEEEDASH_JOURNAL_INVALID);
+    case Status::JournalReadFailed:
+      return tr(STR_SEEEDASH_JOURNAL_READ_ERROR);
+    case Status::JournalEraseFailed:
+      return tr(STR_SEEEDASH_JOURNAL_ERASE_ERROR);
+    case Status::JournalWriteFailed:
+      return tr(STR_SEEEDASH_JOURNAL_WRITE_ERROR);
+    case Status::JournalVerifyFailed:
+      return tr(STR_SEEEDASH_JOURNAL_VERIFY_ERROR);
+    case Status::JournalExhausted:
+      return tr(STR_SEEEDASH_JOURNAL_EXHAUSTED);
+    case Status::MemoryUnavailable:
+      return tr(STR_SEEEDASH_MEMORY_ERROR);
+    case Status::PowerHoldFailed:
+      return tr(STR_SEEEDASH_POWER_ERROR);
+    case Status::SelectionFailed:
+      return tr(STR_SEEEDASH_NOT_AVAILABLE);
+  }
+  return tr(STR_SEEEDASH_NOT_AVAILABLE);
+}
