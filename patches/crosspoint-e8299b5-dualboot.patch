+void SettingsActivity::openSeeedashSwitch() {
+  const auto status = HalSystem::checkSeeedashBoot();
+  if (status != HalSystem::SeeedashBootStatus::Ready) {
+    const char* options[] = {tr(STR_CANCEL)};
+    const char* message = seeedashErrorMessage(status);
+    optionPopup.showMessage(tr(STR_SWITCH_TO_SEEEDASH), message, options, 1, 0, [](int) {});
+    requestUpdate();
+    return;
+  }
+  const char* options[] = {tr(STR_CANCEL), tr(STR_SWITCH_TO_SEEEDASH)};
+  optionPopup.showMessage(tr(STR_SWITCH_TO_SEEEDASH), tr(STR_SEEEDASH_SWITCH_CONFIRM), options, 2, 0,
+                          [this](int index) {
+                            if (index != 1) return;
+                            SETTINGS.saveToFile();
+                            const auto selected = HalSystem::selectSeeedashBoot();
+                            if (selected == HalSystem::SeeedashBootStatus::Ready) {
+                              ESP.restart();
+                              return;
+                            }
+                            seeedashSwitchError = selected;
+                          });
+  requestUpdate();
+}
