+namespace {
+struct SeeedashPartition {
+  const char* label;
+  esp_partition_type_t type;
+  esp_partition_subtype_t subtype;
+  uint32_t address;
+  uint32_t size;
+};
+
+constexpr SeeedashPartition SEEEDASH_PARTITIONS[] = {
+    {"nvs", ESP_PARTITION_TYPE_DATA, ESP_PARTITION_SUBTYPE_DATA_NVS, 0x9000, 0x7d000},
+    {"otadata", ESP_PARTITION_TYPE_DATA, ESP_PARTITION_SUBTYPE_DATA_OTA, 0x86000, 0x2000},
+    {"phy_init", ESP_PARTITION_TYPE_DATA, ESP_PARTITION_SUBTYPE_DATA_PHY, 0x88000, 0x1000},
+#if CROSSPOINT_STICKY_DUALBOOT
+    {"cp_nvs", ESP_PARTITION_TYPE_DATA, ESP_PARTITION_SUBTYPE_DATA_NVS, 0x89000, 0x5000},
+    {"bootstate", ESP_PARTITION_TYPE_DATA, static_cast<esp_partition_subtype_t>(0x40), 0x8e000, 0x2000},
+#endif
+    {"app0", ESP_PARTITION_TYPE_APP, ESP_PARTITION_SUBTYPE_APP_OTA_0, 0x90000, 0x600000},
+#if CROSSPOINT_STICKY_DUALBOOT
+    {"app1", ESP_PARTITION_TYPE_APP, ESP_PARTITION_SUBTYPE_APP_TEST, 0x690000, 0x600000},
+#else
+    {"app1", ESP_PARTITION_TYPE_APP, ESP_PARTITION_SUBTYPE_APP_OTA_1, 0x690000, 0x600000},
+#endif
+    {"sys_storage", ESP_PARTITION_TYPE_DATA, ESP_PARTITION_SUBTYPE_DATA_LITTLEFS, 0xc90000, 0x930000},
+    {"usr_storage", ESP_PARTITION_TYPE_DATA, ESP_PARTITION_SUBTYPE_DATA_LITTLEFS, 0x15c0000, 0xa00000},
+    {"coredump", ESP_PARTITION_TYPE_DATA, ESP_PARTITION_SUBTYPE_DATA_COREDUMP, 0x1fc0000, 0x40000},
+};
+
+bool matchesSeeedashLayout() {
+  for (const auto& expected : SEEEDASH_PARTITIONS) {
+    const auto* actual = esp_partition_find_first(expected.type, expected.subtype, expected.label);
+    if (!actual || actual->address != expected.address || actual->size != expected.size || actual->encrypted ||
+        actual->readonly) {
+      LOG_ERR("BOOT", "Partition %s mismatch (expected subtype=%u @0x%lx size=0x%lx)", expected.label,
+              static_cast<unsigned>(expected.subtype), static_cast<unsigned long>(expected.address),
+              static_cast<unsigned long>(expected.size));
+      return false;
+    }
+  }
+  const auto* running = esp_ota_get_running_partition();
+#if CROSSPOINT_STICKY_DUALBOOT
+  auto count = esp_partition_find(ESP_PARTITION_TYPE_ANY, ESP_PARTITION_SUBTYPE_ANY, nullptr);
+  unsigned entries = 0;
+  for (auto it = count; it; it = esp_partition_next(it)) ++entries;
+  if (entries != sizeof(SEEEDASH_PARTITIONS) / sizeof(SEEEDASH_PARTITIONS[0])) return false;
+  return running && running->address == 0x690000 && running->subtype == ESP_PARTITION_SUBTYPE_APP_TEST;
+#else
+  return running && running->address == 0x690000 && running->subtype == ESP_PARTITION_SUBTYPE_APP_OTA_1;
+#endif
+}
+
+struct SeeedashVerification {
+  esp_image_metadata_t metadata;
+#if CROSSPOINT_STICKY_DUALBOOT
+  mbedtls_sha256_context hash;
+  uint8_t chunk[128];
+  uint8_t digest[32];
+#endif
+};
+
+#if CROSSPOINT_STICKY_DUALBOOT
+bool matchesSelectorBootloader(SeeedashVerification& verification) {
+  auto& metadata = verification.metadata;
+  const esp_partition_pos_t pos = {0, 0x8000};
+  if (esp_image_verify(ESP_IMAGE_VERIFY, &pos, &metadata) != ESP_OK || metadata.image.hash_appended != 1 ||
+      metadata.image.spi_size != 5 || metadata.image_len < 32 || metadata.image_len > 0x8000)
+    return false;
+  // IDF skips the appended bootloader SHA in non-secure mode. Verify it explicitly.
+  auto& hash = verification.hash;
+  mbedtls_sha256_init(&hash);
+  bool ok = mbedtls_sha256_starts(&hash, 0) == 0;
+  auto& chunk = verification.chunk;
+  size_t matched = 0;
+  bool contract = false;
+  static constexpr char marker[] = STICKY_BOOT_CONTRACT;
+  const uint32_t bodyLength = metadata.image_len - 32;
+  for (uint32_t off = 0; ok && off < bodyLength;) {
+    const size_t size = std::min(sizeof(chunk), static_cast<size_t>(bodyLength - off));
+    ok = esp_flash_read(nullptr, chunk, off, size) == ESP_OK && mbedtls_sha256_update(&hash, chunk, size) == 0;
+    for (size_t i = 0; ok && i < size && !contract; ++i) {
+      matched = chunk[i] == marker[matched] ? matched + 1 : (chunk[i] == marker[0] ? 1 : 0);
+      contract = matched == sizeof(marker) - 1;
+    }
+    off += size;
+  }
+  auto& digest = verification.digest;
+  ok = ok && mbedtls_sha256_finish(&hash, digest) == 0 &&
+       std::memcmp(digest, metadata.image_digest, sizeof(digest)) == 0;
+  mbedtls_sha256_free(&hash);
+  return ok && contract;
+}
+
+const esp_partition_t* selectorJournal() {
+  return esp_partition_find_first(ESP_PARTITION_TYPE_DATA, static_cast<esp_partition_subtype_t>(0x40), "bootstate");
+}
+bool readSelector(void* ctx, unsigned sector, boot_record_t* record) {
+  return sector < 2 &&
+         esp_partition_read(static_cast<const esp_partition_t*>(ctx), sector * 4096, record, sizeof(*record)) == ESP_OK;
+}
+bool eraseSelector(void* ctx, unsigned sector) {
+  return sector < 2 &&
+         esp_partition_erase_range(static_cast<const esp_partition_t*>(ctx), sector * 4096, 4096) == ESP_OK;
+}
+bool writeSelector(void* ctx, unsigned sector, const boot_record_t* record) {
+  return sector < 2 && esp_partition_write(static_cast<const esp_partition_t*>(ctx), sector * 4096, record,
+                                           sizeof(*record)) == ESP_OK;
+}
+bool validatedSeeedash(void*, boot_target_t target) { return target == BOOT_SEEEDASH; }
+
+SeeedashBootStatus checkSelectorJournal() {
+  const auto* journal = selectorJournal();
+  boot_record_t records[2];
+  if (!journal || !readSelector(const_cast<esp_partition_t*>(journal), 0, &records[0]) ||
+      !readSelector(const_cast<esp_partition_t*>(journal), 1, &records[1]))
+    return SeeedashBootStatus::JournalReadFailed;
+  static constexpr uint8_t tag[20] = {'S', 'T', 'K', 'Y', '-', 'B', 'O', 'O', 'T', '-',
+                                      'V', '1', 255, 255, 255, 255, 255, 255, 255, 255};
+  for (const auto& r : records) {
+    if (boot_record_valid(&r) && std::memcmp(r.label, tag, sizeof(tag)) == 0) return SeeedashBootStatus::Ready;
+  }
+  return SeeedashBootStatus::JournalInvalid;
+}
+
+bool holdSelectorPower() {
+  if (BoardConfig::ACTIVE.power.latch0 != 45 || BoardConfig::ACTIVE.power.latch1 != 46) return false;
+  // Keep U3 D high before clocking CP. Do not enter sleep or release the battery latch.
+  if (gpio_hold_dis(GPIO_NUM_45) != ESP_OK || gpio_set_level(GPIO_NUM_45, 1) != ESP_OK ||
+      gpio_set_direction(GPIO_NUM_45, GPIO_MODE_OUTPUT) != ESP_OK || gpio_hold_dis(GPIO_NUM_46) != ESP_OK ||
+      gpio_set_level(GPIO_NUM_46, 0) != ESP_OK || gpio_set_direction(GPIO_NUM_46, GPIO_MODE_OUTPUT) != ESP_OK)
+    return false;
+  esp_rom_delay_us(2);
+  return gpio_set_level(GPIO_NUM_46, 1) == ESP_OK && gpio_hold_en(GPIO_NUM_45) == ESP_OK &&
+         gpio_hold_en(GPIO_NUM_46) == ESP_OK;
+}
+#endif
+}  // namespace
+
+bool firmwareUpdatesAllowed() {
+  if (!BoardConfig::isSticky()) return true;
+  // Detect vendor storage even if the rest of the layout is damaged or changed.
+  return !esp_partition_find_first(ESP_PARTITION_TYPE_DATA, ESP_PARTITION_SUBTYPE_ANY, "sys_storage") &&
+         !esp_partition_find_first(ESP_PARTITION_TYPE_DATA, ESP_PARTITION_SUBTYPE_ANY, "usr_storage");
+}
+
+SeeedashBootStatus checkSeeedashBoot() {
+  if (!BoardConfig::isSticky() || !matchesSeeedashLayout()) {
+    LOG_ERR("BOOT", "Seeedash partition layout or running app1 subtype mismatch");
+    return SeeedashBootStatus::LayoutMismatch;
+  }
+
+// Enable only for a deployment whose bootloader button return has passed device tests.
+#if !CROSSPOINT_STICKY_DUALBOOT && \
+    (!defined(CROSSPOINT_SEEEDASH_RETURN_VERIFIED) || CROSSPOINT_SEEEDASH_RETURN_VERIFIED != 1)
+  LOG_ERR("BOOT", "Seeedash return path has not been verified for this build");
+  return SeeedashBootStatus::ReturnNotVerified;
+#else
+  // Appended image digest from the SHA-256-verified official Seeedash 1.2.0 package.
+  static constexpr uint8_t SEEEDASH_DIGEST[32] = {0xb7, 0x18, 0x44, 0x69, 0xaa, 0x47, 0xa6, 0x80, 0xc2, 0x93, 0x84,
+                                                  0x8b, 0x26, 0x43, 0x42, 0x70, 0x5c, 0xc8, 0x17, 0x68, 0x9f, 0x4f,
+                                                  0x76, 0x93, 0xd2, 0xe6, 0x74, 0xf0, 0xab, 0x23, 0xee, 0xc7};
+  const esp_partition_pos_t position = {0x90000, 0x600000};
+  // One checked, short-lived block reuses the metadata allocation for SHA scratch too.
+  auto verification = makeUniqueNoThrow<SeeedashVerification>();
+  if (!verification) {
+    LOG_ERR("BOOT", "OOM: Seeedash verification workspace (%zu bytes)", sizeof(SeeedashVerification));
+    return SeeedashBootStatus::MemoryUnavailable;
+  }
+  auto* metadata = &verification->metadata;
+#if CROSSPOINT_STICKY_DUALBOOT
+  if (!matchesSelectorBootloader(*verification)) {
+    LOG_ERR("BOOT", "Bootloader image integrity or selector protocol mismatch");
+    return SeeedashBootStatus::BootloaderMismatch;
+  }
+  const auto journalStatus = checkSelectorJournal();
+  if (journalStatus != SeeedashBootStatus::Ready) return journalStatus;
+#endif
+  if (esp_image_verify(ESP_IMAGE_VERIFY, &position, metadata) != ESP_OK || metadata->image_len != 3261088 ||
+      metadata->image.hash_appended != 1 || metadata->image.spi_size != 5 ||
+      std::memcmp(metadata->image_digest, SEEEDASH_DIGEST, sizeof(SEEEDASH_DIGEST)) != 0) {
+    LOG_ERR("BOOT", "Seeedash 1.2.0 image verification failed");
+    return SeeedashBootStatus::ImageMismatch;
+  }
+  return SeeedashBootStatus::Ready;
+#endif
+}
+
+SeeedashBootStatus selectSeeedashBoot() {
+  const auto status = checkSeeedashBoot();
+  if (status != SeeedashBootStatus::Ready) return status;
+#if CROSSPOINT_STICKY_DUALBOOT
+  if (!holdSelectorPower()) return SeeedashBootStatus::PowerHoldFailed;
+  auto* journal = const_cast<esp_partition_t*>(selectorJournal());
+  const boot_ops_t ops = {journal, readSelector, eraseSelector, writeSelector, validatedSeeedash, true};
+  boot_result_t result;
+  const boot_status_t selected = boot_choose(&ops, BOOT_SOFTWARE, true, &result);
+  LOG_INF("BOOT", "Menu request: reset=%d selector_status=%d target=%d wrote=%d; power latch held", esp_reset_reason(),
+          selected, result.target, result.wrote_selection);
+  switch (selected) {
+    case BOOT_OK:
+      if (result.target != BOOT_SEEEDASH || result.fallback) return SeeedashBootStatus::SelectionFailed;
+      break;
+    case BOOT_NO_IMAGE:
+      return SeeedashBootStatus::ImageMismatch;
+    case BOOT_READ_ERROR:
+      return SeeedashBootStatus::JournalReadFailed;
+    case BOOT_ERASE_ERROR:
+      return SeeedashBootStatus::JournalEraseFailed;
+    case BOOT_WRITE_ERROR:
+      return SeeedashBootStatus::JournalWriteFailed;
+    case BOOT_VERIFY_ERROR:
+      return SeeedashBootStatus::JournalVerifyFailed;
+    case BOOT_SEQUENCE_EXHAUSTED:
+      return SeeedashBootStatus::JournalExhausted;
+  }
+#else
+  const auto* target = esp_partition_find_first(ESP_PARTITION_TYPE_APP, ESP_PARTITION_SUBTYPE_APP_OTA_0, "app0");
+  // Keep IDF's image checks and redundant otadata writes; never use the C3 raw-write bypass here.
+  if (!target || esp_ota_set_boot_partition(target) != ESP_OK) {
+    LOG_ERR("BOOT", "Could not select Seeedash boot partition");
+    return SeeedashBootStatus::SelectionFailed;
+  }
+#endif
+  return SeeedashBootStatus::Ready;
+}
