# Deny by default. Only reviewed source and build metadata enter the context.
**
!Dockerfile
!.dockerignore
!VERSION
!README.md
!LICENSE
!NOTICE
!SOURCE_FILES.sha256
!requirements-build.txt
!scripts/
!scripts/**
!tests/
!tests/**
!firmware/
!firmware/**
!crosspoint/
!crosspoint/**
!partitions/
!partitions/**
!patches/
!patches/**
!manifests/
!manifests/**
!licenses/
!licenses/**
!docker/
!docker/**
# Even an accidental file in an included directory must not carry local data.
**/__pycache__/**
**/*.pyc
**/*.bin
**/*.elf
**/*.map
**/*.log
**/*.zip
**/*.tar.gz
**/*.pem
**/*.key
**/.env
**/.git/**
**/.local/**
**/.work/**
**/.cache/**
out/**
dist/**
